		{
			"id": "festival:cue-b-05",
			"beatId": "festival:beat-b-01",
			"order": 4,
			"type": "action",
			"text": "Zao comprueba wireless y ambos enlaces cableados. El control dedicado del láser exterior sigue activo; descarta Tierra y Proxima y ajusta un barrido sobre la posición futura de la nave."
		},
		{
			"id": "festival:cue-b-01",
			"beatId": "festival:beat-b-01",
			"order": 5,
			"type": "dialogue",
			"speakerId": "character:zao",
			"presentation": "recording",
			"content": {
				"sourceLanguage": "es",
				"variants": {
					"es": {
						"spokenText": "Si esto llega... Aqueronte está adentro. Harlan alteró el núcleo. El registro superficial es falso. Crucen la rutina con el relé físico. No apaguen la mediación.",
						"status": "source"
					}
				}
			}
		},
		{
			"id": "festival:cue-b-06",
			"beatId": "festival:beat-b-01",
			"order": 6,
			"type": "action",
			"text": "El envío completa el barrido cuando Harlan entra por el ramal técnico; sólo alcanza a ver TRANSMITIDO, no el destino."
		},
		{
			"id": "festival:cue-c-01",
			"beatId": "festival:beat-c-01",
			"order": 1,
			"type": "action",
			"text": "Harlan mata a Zao fuera de campo, borra cámaras y archivo local y regresa por el cilindro de servicio."
		},
		{
			"id": "festival:cue-c-02",
			"beatId": "festival:beat-c-01",
			"order": 2,
			"type": "action",
			"text": "Sorell llega sola por el cilindro central, intenta reanimar a Zao y no logra comunicarse mientras el jammer sigue activo."
		},
		{
			"id": "festival:cue-c-03",
			"beatId": "festival:beat-c-01",
			"order": 3,
			"type": "action",
			"text": "Harlan restaura COM A/B, vuelve al puente y niega haber visto a Sorell; Voss lo envía con Okoye al núcleo."
		},
		{
			"id": "festival:cue-d-01",
			"beatId": "festival:beat-d-01",
			"order": 1,
			"type": "dialogue",
