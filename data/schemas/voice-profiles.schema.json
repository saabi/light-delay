{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://light-delay.local/schemas/voice-profiles.schema.json",
  "type": "object",
  "required": ["schemaVersion", "voiceProfiles"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "voiceProfiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/voiceProfile" }
    }
  },
  "$defs": {
    "languageFormation": {
      "type": "object",
      "required": ["place", "variety"],
      "properties": {
        "place": { "$ref": "common.schema.json#/$defs/localizedString" },
        "variety": { "$ref": "common.schema.json#/$defs/localizedString" }
      },
      "additionalProperties": false
    },
    "voiceVariant": {
      "type": "object",
      "required": ["language"],
      "properties": {
        "language": { "enum": ["es", "en"] },
        "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
        "languageFormation": { "$ref": "#/$defs/languageFormation" },
        "prosody": { "$ref": "common.schema.json#/$defs/localizedString" },
        "dialogueStyle": { "$ref": "common.schema.json#/$defs/localizedString" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "providerVoiceId": { "type": "string" },
        "sampleAssetIds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "pronunciationMap": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "pronunciationDictionaryAssetId": { "type": "string" },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "voiceProfile": {
      "type": "object",
      "required": ["id", "name", "variants"],
      "properties": {
        "id": { "type": "string", "pattern": "^voice:" },
        "characterId": { "type": "string", "pattern": "^character:" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "$ref": "common.schema.json#/$defs/localizedString" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/voiceVariant" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
