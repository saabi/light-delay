{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://light-delay.local/schemas/generation-plan.schema.json",
  "type": "object",
  "required": ["schemaVersion", "plan", "shots"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "plan": {
      "type": "object",
      "required": ["id", "scriptId", "scriptVersion", "sourceDigest", "campaignId", "status", "promptLanguage", "diegeticTextLanguage"],
      "properties": {
        "id": { "type": "string" }, "scriptId": { "type": "string" }, "scriptVersion": { "type": "string" },
        "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "campaignId": { "type": "string" },
        "status": { "enum": ["blocked", "draft", "ready", "frozen", "executed", "obsolete"] },
        "promptLanguage": { "const": "en" },
        "diegeticTextLanguage": { "const": "en" },
        "briefLanguage": { "const": "es" },
        "generatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shotId", "status", "blockers", "diegeticText", "artifacts", "requiredReferences", "segments"],
        "properties": {
          "shotId": { "type": "string" }, "status": { "enum": ["blocked", "draft", "ready", "frozen", "generated", "accepted"] },
          "blockers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "diegeticText": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "artifacts": {
            "type": "object",
            "required": ["animaticStill"],
            "properties": {
              "animaticStill": { "$ref": "#/$defs/artifact" },
              "firstFrame": { "$ref": "#/$defs/artifact" },
              "lastFrame": { "$ref": "#/$defs/artifact" },
              "finalAudio": { "$ref": "#/$defs/artifact" }
            },
            "additionalProperties": false
          },
          "requiredReferences": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
          "generationGate": { "$ref": "#/$defs/generationGate" },
          "videoGenerationGate": {
            "$ref": "#/$defs/generationGate",
            "description": "Derived from video-scoped Take.productionGate holds only (medium: video). Affects segments/video jobs; never the animatic still."
          },
          "segments": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "startMs", "endMs", "continuation", "promptStatus", "compiledPrompt"],
              "properties": {
                "id": { "type": "string" }, "startMs": { "type": "integer", "minimum": 0 }, "endMs": { "type": "integer", "minimum": 1 },
                "continuation": { "enum": ["none", "accepted_video_and_last_frame", "last_frame_as_next_first"] },
                "promptStatus": { "enum": ["blocked", "draft", "ready", "frozen"] },
                "compiledPrompt": { "type": ["string", "null"] },
                "blockers": {
                  "type": "array",
                  "items": { "type": "string" },
                  "uniqueItems": true,
                  "description": "Video-only blockers for this segment (e.g. video_generation_deferred, generation_deferred:video:<takeId>)."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "visualStretchJobs": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/visualStretchJob" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["required", "status"],
      "properties": { "required": { "type": "boolean" }, "status": { "enum": ["missing", "planned", "generated", "accepted", "rejected"] }, "assetId": { "type": "string" } },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": ["kind", "id", "required"],
      "properties": { "kind": { "enum": ["image", "video", "audio"] }, "id": { "type": "string" }, "path": { "type": "string", "minLength": 1 }, "required": { "type": "boolean" }, "role": { "type": "string" } },
      "additionalProperties": false
    },
    "gridLayout": {
      "type": "object",
      "required": ["rows", "cols", "gutterFraction", "panelAspect"],
      "properties": {
        "rows": { "type": "integer", "minimum": 1 },
        "cols": { "type": "integer", "minimum": 1 },
        "gutterFraction": { "type": "number", "minimum": 0, "exclusiveMaximum": 0.5 },
        "panelAspect": { "const": "16:9" },
        "blankCells": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "minOuterMarginFraction": { "type": "number", "minimum": 0, "maximum": 0.4 }
      },
      "additionalProperties": false
    },
    "computedMargins": {
      "type": "object",
      "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": { "type": "number", "minimum": 0, "maximum": 1 },
        "right": { "type": "number", "minimum": 0, "maximum": 1 },
        "bottom": { "type": "number", "minimum": 0, "maximum": 1 },
        "left": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "frameRegion": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" }
      },
      "additionalProperties": false
    },
    "generationGate": {
      "type": "object",
      "description": "Derived from Take.productionGate on source takes. Script take remains SoT; never hand-author on the plan. When source takes mix deferred and blocked, derived status is deferred (union of deferred prerequisites; all hold takeIds retained). `medium` is the hold scope: 'all' blocks stills and video; 'still' blocks stills only; 'video' blocks video only and never makes a still job non-runnable.",
      "required": ["status", "reasonCode", "takeIds"],
      "properties": {
        "status": { "enum": ["deferred", "blocked"] },
        "medium": { "enum": ["all", "still", "video"] },
        "reasonCode": { "type": "string", "minLength": 1 },
        "takeIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "prerequisiteAssetIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "deferred" } }, "required": ["status"] },
          "then": {
            "required": ["prerequisiteAssetIds"],
            "properties": {
              "prerequisiteAssetIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
          "then": {
            "properties": {
              "prerequisiteAssetIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "maxItems": 0,
                "uniqueItems": true
              }
            }
          }
        }
      ]
    },
    "visualStretchJob": {
      "type": "object",
      "required": ["id", "stretchId", "revision", "medium", "mode", "providerSnapshotId", "outputTakePolicy", "memberInputs", "stillReferenceAssetIds", "sharedReferenceAssetIds", "compiledPrompt", "outputs", "blockers", "coherenceException"],
      "properties": {
        "id": { "type": "string" },
        "stretchId": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "medium": { "enum": ["still", "video"] },
        "mode": { "enum": ["combined_storyboard_sheet", "independent_shared_authority", "grouped_seedance"] },
        "providerSnapshotId": { "type": "string", "minLength": 1 },
        "outputTakePolicy": { "const": "new_candidate" },
        "memberInputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["order", "shotId", "sourceTakeIds"],
            "properties": {
              "order": { "type": "integer", "minimum": 1 },
              "shotId": { "type": "string" },
              "sourceTakeIds": { "type": "array", "items": { "type": "string" } },
              "keyframeAssetId": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "dependsOnStillJobId": { "type": "string" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "stillReferenceAssetIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Complete stretch still/keyframe reference list (never trimmed for video)."
        },
        "videoReferencePolicy": {
          "enum": ["fallback", "explicit"],
          "description": "Video jobs only. fallback = derive extras from still list; explicit = use authored videoReferenceAssetIds (may be empty)."
        },
        "videoReferenceAssetIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Authored video-only static refs. Present only when videoReferencePolicy is explicit."
        },
        "effectiveVideoReferenceAssetIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Derived video visual extras after keyframe coverage (no keyframes, no voice). Never hand-author."
        },
        "voiceSampleAssetIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Derived approved dialogue voice samples for the video job."
        },
        "sharedReferenceAssetIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Deprecated alias: still jobs = stillReferenceAssetIds; video jobs = effectiveVideoReferenceAssetIds. Must match."
        },
        "gridLayout": { "$ref": "#/$defs/gridLayout" },
        "computedMargins": { "$ref": "#/$defs/computedMargins" },
        "compiledPrompt": { "type": ["string", "null"] },
        "promptDigest": { "type": "string" },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["order", "artifact"],
            "properties": {
              "order": { "type": "integer", "minimum": 1 },
              "artifact": { "enum": ["combinedStoryboard", "animaticStill", "firstFrame", "lastFrame", "video"] },
              "assetId": { "type": "string" },
              "supersededByJobId": { "type": "string" },
              "panels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["order", "shotId", "sourceTakeIds", "frameRegion"],
                  "properties": {
                    "order": { "type": "integer", "minimum": 1 },
                    "shotId": { "type": "string" },
                    "sourceTakeIds": { "type": "array", "items": { "type": "string" } },
                    "derivedTakeId": { "type": "string" },
                    "frameRegion": { "$ref": "#/$defs/frameRegion" },
                    "derivedAssetId": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "coherenceException": { "type": "boolean" },
        "runnable": {
          "type": "boolean",
          "description": "Submission adapters must refuse the job unless runnable is true (requires empty blockers)."
        },
        "generationGate": { "$ref": "#/$defs/generationGate" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "medium": { "const": "still" } }, "required": ["medium"] },
          "then": {
            "properties": {
              "mode": { "enum": ["combined_storyboard_sheet", "independent_shared_authority"] },
              "videoReferencePolicy": false,
              "videoReferenceAssetIds": false
            }
          }
        },
        {
          "if": { "properties": { "medium": { "const": "video" } }, "required": ["medium"] },
          "then": {
            "properties": {
              "mode": { "const": "grouped_seedance" },
              "dependsOnStillJobId": { "type": "string", "minLength": 1 },
              "videoReferencePolicy": { "enum": ["fallback", "explicit"] },
              "effectiveVideoReferenceAssetIds": { "type": "array", "items": { "type": "string" } },
              "stillReferenceAssetIds": { "type": "array", "items": { "type": "string" } }
            },
            "required": [
              "dependsOnStillJobId",
              "stillReferenceAssetIds",
              "videoReferencePolicy",
              "effectiveVideoReferenceAssetIds"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "medium": { "const": "video" },
              "videoReferencePolicy": { "const": "explicit" }
            },
            "required": ["medium", "videoReferencePolicy"]
          },
          "then": {
            "required": ["videoReferenceAssetIds"],
            "properties": {
              "videoReferenceAssetIds": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        {
          "if": {
            "properties": {
              "medium": { "const": "video" },
              "videoReferencePolicy": { "const": "fallback" }
            },
            "required": ["medium", "videoReferencePolicy"]
          },
          "then": {
            "properties": {
              "videoReferenceAssetIds": false
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "combined_storyboard_sheet" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "gridLayout": { "$ref": "#/$defs/gridLayout" }
            },
            "required": ["gridLayout"]
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
