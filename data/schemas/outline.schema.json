{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://light-delay.local/schemas/outline.schema.json",
  "type": "object",
  "required": ["schemaVersion", "outline", "steps"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "outline": {
      "type": "object",
      "required": ["id", "scriptId", "title", "synopsis", "status", "version"],
      "properties": {
        "id": { "type": "string" }, "scriptId": { "type": "string" },
        "title": { "$ref": "common.schema.json#/$defs/localizedString" },
        "synopsis": { "$ref": "common.schema.json#/$defs/localizedString" },
        "status": { "enum": ["draft", "reviewed", "locked", "deprecated"] }, "version": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "localization": {
          "type": "object",
          "required": ["sourceLanguage", "translations"],
          "properties": {
            "sourceLanguage": { "const": "en" },
            "translations": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "enum": ["current", "needs_revision", "not_started"] },
                  "lastSyncedRevision": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "editorialNotice": { "$ref": "common.schema.json#/$defs/localizedString" },
        "derivation": {
          "type": "object",
          "required": ["sourceOutlineId", "sourceRevision", "relationship", "fidelity", "reviewStatus"],
          "properties": {
            "sourceOutlineId": { "type": "string", "minLength": 1 },
            "sourceRevision": { "type": "integer", "minimum": 1 },
            "sourceVersion": { "type": "string", "minLength": 1 },
            "relationship": { "const": "adaptation" },
            "fidelity": { "const": "complete_causal_chain" },
            "reviewStatus": { "enum": ["current", "stale", "review_required"] }
          },
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "required": ["path", "revision", "language"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 },
            "language": { "type": "string", "minLength": 2 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "importedFrom": {
              "type": "array",
              "items": { "$ref": "#/$defs/outlineSource" }
            }
          },
          "additionalProperties": false
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "language", "format"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "language": { "type": "string", "minLength": 2 },
              "format": { "const": "markdown" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "framing": {
      "type": "array",
      "items": { "$ref": "#/$defs/framingSection" }
    },
    "storySections": {
      "type": "array",
      "items": { "$ref": "#/$defs/storySection" }
    },
    "facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/outlineFact" }
    },
    "knowledgeEvents": {
      "type": "array",
      "items": { "$ref": "#/$defs/outlineKnowledgeEvent" }
    },
    "actionRequirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/outlineActionRequirement" }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "level", "order", "title", "importance"],
        "properties": {
          "id": { "type": "string" }, "order": { "type": "integer", "minimum": 1 },
          "level": { "enum": ["story", "detail"] },
          "parentStepId": { "type": "string" },
          "sectionId": { "type": "string" },
          "title": { "$ref": "common.schema.json#/$defs/localizedString" },
          "summary": { "$ref": "common.schema.json#/$defs/localizedString" },
          "body": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/proseBlock" }
          },
          "importance": { "enum": ["required", "optional"] },
          "status": { "enum": ["planned", "covered", "missing", "deferred"] },
          "causalLinks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["sourceStepId", "relation", "explanation"],
              "properties": {
                "sourceStepId": { "type": "string" },
                "relation": { "enum": ["enables", "motivates", "reveals", "forces", "prevents", "pays_off"] },
                "explanation": { "$ref": "common.schema.json#/$defs/localizedString" }
              },
              "additionalProperties": false
            }
          },
          "coverage": {
            "type": "object",
            "properties": {
              "treatment": { "$ref": "#/$defs/coverageEvidence" },
              "script": { "$ref": "#/$defs/coverageEvidence" },
              "animatic": { "$ref": "#/$defs/coverageEvidence" }
            },
            "additionalProperties": false
          },
          "majorEventId": { "type": "string" },
          "sceneIds": { "$ref": "#/$defs/idList" }, "beatIds": { "$ref": "#/$defs/idList" },
          "cueIds": { "$ref": "#/$defs/idList" }, "shotIds": { "$ref": "#/$defs/idList" },
          "dependsOnStepIds": { "$ref": "#/$defs/idList" },
          "requiresFactIds": { "$ref": "#/$defs/idList" },
          "revealsFactIds": { "$ref": "#/$defs/idList" },
          "sourceRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sourceRef" } },
          "notes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/note" } }
        },
        "oneOf": [
          { "required": ["summary"], "properties": { "summary": {}, "body": false } },
          { "required": ["body"], "properties": { "body": {}, "summary": false } }
        ],
        "allOf": [
          {
            "if": { "required": ["body"], "properties": { "body": { "type": "array" } } },
            "then": { "properties": { "level": { "const": "story" } } }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "outlineFact": {
      "type": "object",
      "required": ["id", "description", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^master:fact-" },
        "description": { "$ref": "common.schema.json#/$defs/localizedString" },
        "dependsOnFactIds": { "$ref": "#/$defs/idList" },
        "introducedInStepId": { "type": "string", "minLength": 1 },
        "audienceVisibility": { "enum": ["overt", "withheld", "implied"] },
        "status": { "enum": ["active", "retired"] },
        "legacyIds": { "$ref": "#/$defs/idList" }
      },
      "additionalProperties": false
    },
    "outlineKnowledgeEvent": {
      "type": "object",
      "required": ["stepId", "factId", "characterIds"],
      "properties": {
        "stepId": { "type": "string", "minLength": 1 },
        "factId": { "type": "string", "pattern": "^master:fact-" },
        "characterIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^character:" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "outlineActionRequirement": {
      "type": "object",
      "required": ["stepId", "actorId", "action", "requiresKnownFactIds"],
      "properties": {
        "stepId": { "type": "string", "minLength": 1 },
        "actorId": { "type": "string", "pattern": "^character:" },
        "action": { "$ref": "common.schema.json#/$defs/localizedString" },
        "requiresKnownFactIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^master:fact-" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "outlineSource": {
      "type": "object",
      "required": ["path", "revision", "language"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "proseBlock": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "paragraph" },
            "text": { "$ref": "common.schema.json#/$defs/localizedString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "level", "text"],
          "properties": {
            "type": { "const": "heading" },
            "level": { "enum": [3, 4] },
            "text": { "$ref": "common.schema.json#/$defs/localizedString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "list" },
            "ordered": { "type": "boolean" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "common.schema.json#/$defs/localizedString" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "blockquote" },
            "text": { "$ref": "common.schema.json#/$defs/localizedString" },
            "speakerId": { "type": "string", "pattern": "^character:" }
          },
          "additionalProperties": false
        }
      ]
    },
    "framingSection": {
      "type": "object",
      "required": ["id", "placement", "order", "kind", "title", "blocks"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "placement": { "enum": ["before_story", "after_story"] },
        "order": { "type": "integer", "minimum": 1 },
        "kind": {
          "enum": ["purpose", "terminology", "premise", "setting", "physics", "gravity", "cast", "motivation", "stakes", "throughlines", "production_choices", "other"]
        },
        "title": { "$ref": "common.schema.json#/$defs/localizedString" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/proseBlock" }
        }
      },
      "additionalProperties": false
    },
    "storySection": {
      "type": "object",
      "required": ["id", "order", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "common.schema.json#/$defs/localizedString" }
      },
      "additionalProperties": false
    },
    "idList": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "coverageEvidence": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["not_started", "partial", "covered", "deferred", "not_applicable"] },
        "sourceRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sourceRef" } },
        "sceneIds": { "$ref": "#/$defs/idList" },
        "beatIds": { "$ref": "#/$defs/idList" },
        "cueIds": { "$ref": "#/$defs/idList" },
        "shotIds": { "$ref": "#/$defs/idList" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
