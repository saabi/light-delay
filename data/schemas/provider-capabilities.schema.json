{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://light-delay.local/schemas/provider-capabilities.schema.json",
  "type": "object",
  "required": ["schemaVersion", "snapshots", "campaigns"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "provider", "model", "capturedAt", "confidence", "executable", "limits", "source", "medium", "limitSurface"],
        "properties": {
          "id": { "type": "string" },
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "medium": { "enum": ["image", "video"] },
          "limitSurface": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["api", "mcp", "ui", "account", "model"] },
            "uniqueItems": true
          },
          "capturedAt": { "type": "string", "format": "date" },
          "confidence": { "enum": ["verified", "provisional", "unknown"] },
          "executable": { "type": "boolean" },
          "limits": {
            "type": "object",
            "required": ["maxImages", "maxVideos", "maxAudios", "maxTotalReferences"],
            "properties": {
              "maxImages": { "type": ["integer", "null"], "minimum": 0, "description": "Input reference image count (not outputs)." },
              "maxVideos": { "type": ["integer", "null"], "minimum": 0 },
              "maxAudios": { "type": ["integer", "null"], "minimum": 0 },
              "maxTotalReferences": { "type": ["integer", "null"], "minimum": 0 },
              "maxDurationMs": { "type": ["integer", "null"], "minimum": 1 },
              "maxOutputsPerRequest": { "type": ["integer", "null"], "minimum": 1 },
              "maxConcurrentRequests": {
                "type": ["integer", "null"],
                "minimum": 1,
                "description": "Last-known concurrent generation slots for this model/surface; null until verified for the account."
              }
            },
            "additionalProperties": false
          },
          "supportsCombinedStoryboardSheet": { "type": "boolean" },
          "maxStoryboardPanels": { "type": ["integer", "null"], "minimum": 1 },
          "minPanelResolution": {
            "type": "object",
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "supportedStoryboardLayouts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rows", "columns", "aspectRatio"],
              "properties": {
                "rows": { "type": "integer", "minimum": 1 },
                "columns": { "type": "integer", "minimum": 1 },
                "aspectRatio": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "outputSizes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["width", "height", "aspectRatio"],
              "properties": {
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 },
                "aspectRatio": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "source": { "type": "string" },
          "notes": { "$ref": "common.schema.json#/$defs/localizedString" }
        },
        "additionalProperties": false
      }
    },
    "campaigns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "providerSnapshotId",
          "stillProviderSnapshotId",
          "maxSegmentMs",
          "requiresEntitlementPreflight",
          "noCreditsAllowed"
        ],
        "properties": {
          "id": { "type": "string" },
          "providerSnapshotId": { "type": "string" },
          "stillProviderSnapshotId": { "type": "string" },
          "maxSegmentMs": { "type": "integer", "minimum": 1 },
          "requiresEntitlementPreflight": { "type": "boolean" },
          "noCreditsAllowed": { "type": "boolean" },
          "concurrency": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "Authoritative project concurrent-job ceiling once verified; null until preflight records the account limit. Smoke always uses maxJobs: 1."
          },
          "notes": { "$ref": "common.schema.json#/$defs/localizedString" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
