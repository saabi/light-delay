{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://light-delay.local/schemas/audio-outputs.schema.json",
  "type": "object",
  "required": ["schemaVersion", "outputs"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/output" }
    }
  },
  "$defs": {
    "relativeKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!\\\\)(?!/).+"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "lang",
        "label",
        "description",
        "sourceOutlineId",
        "sourceOutlineRevision",
        "chunksKey",
        "canonicalMp3Key",
        "assembledKey",
        "recordableSpeakers",
        "expectedSampleRate",
        "expectedCueCount"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "type": "string", "enum": ["audience", "outline", "cut-dialogue", "other"] },
        "lang": { "type": "string", "enum": ["es", "en"] },
        "label": { "$ref": "common.schema.json#/$defs/localizedString" },
        "description": { "$ref": "common.schema.json#/$defs/localizedString" },
        "sourceOutlineId": { "type": "string", "pattern": "^outline:[a-z0-9-]+$" },
        "sourceOutlineRevision": { "type": "integer", "minimum": 1 },
        "chunksKey": { "$ref": "#/$defs/relativeKey" },
        "canonicalMp3Key": { "$ref": "#/$defs/relativeKey" },
        "assembledKey": { "$ref": "#/$defs/relativeKey" },
        "recordableSpeakers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "expectedSampleRate": { "type": "integer", "minimum": 8000 },
        "expectedCueCount": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
