{
  "name": "@light-delay/studio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "precheck": "npm run build --workspace @light-delay/v2-core && npm run package --workspace svelte-glyph-capacity",
    "prebuild": "npm run build --workspace @light-delay/v2-core && npm run package --workspace svelte-glyph-capacity",
    "predev": "npm run build --workspace @light-delay/v2-core && npm run package --workspace svelte-glyph-capacity",
    "test:e2e:postgres": "playwright test --config playwright.postgres.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@light-delay/v2-core": "*",
    "@sveltejs/adapter-node": "^5.5.0",
    "@sveltejs/kit": "^2.63.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "svelte-glyph-capacity": "0.1.0"
  }
}
