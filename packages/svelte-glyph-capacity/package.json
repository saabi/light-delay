{
	"name": "svelte-glyph-capacity",
	"version": "0.1.0",
	"description": "A Svelte sensor for measuring rendered glyph dimensions and local text capacity.",
	"type": "module",
	"license": "MIT",
	"author": "Sebastian Ferreyra Pons",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/saabi/svelte-glyph-capacity.git"
	},
	"homepage": "https://github.com/saabi/svelte-glyph-capacity#readme",
	"bugs": {
		"url": "https://github.com/saabi/svelte-glyph-capacity/issues"
	},
	"keywords": [
		"svelte",
		"container-query",
		"responsive-design",
		"typography",
		"glyph-metrics"
	],
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"package": "svelte-kit sync && svelte-package",
		"package:watch": "svelte-kit sync && svelte-package --watch",
		"publint": "publint --pack=false",
		"test": "playwright test",
		"validate": "npm run lint && npm run check && npm test && npm run build && npm run package && npm run publint",
		"prepublishOnly": "npm run package && npm run check"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.31.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^26.2.0",
		"prettier": "^3.9.0",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.23",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"engines": {
		"node": "^20.19.0 || ^22.12.0 || >=24.0.0"
	}
}
